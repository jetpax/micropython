/*
 * Original Pi Zero W devicetree overlay for MicroPython on Zephyr.
 *
 * First light: the REPL on USB CDC ACM and nothing else. No HAT, no
 * display, no Wi-Fi -- unlike the Zero 2 W overlay, which is mostly
 * Pirate Audio wiring.
 *
 * &mbox0 + &firmware come up so the DWC2 vendor pre_enable hook can
 * SET_POWER_STATE(USB_HCD, on) at boot and hwinfo can read the board
 * serial for iSerialNumber. The kernel `zephyr,console` stays on the
 * mini-UART (set by the board DTS) so boot logs and panics keep a
 * dedicated channel; only the REPL moves to CDC.
 */

&mbox0 {
	status = "okay";
};

&firmware {
	status = "okay";
};

&usb {
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "MP REPL";
	};
};

/ {
	chosen {
		zephyr,uart-mp-repl = &cdc_acm_uart0;
	};
};

/*
 * Legacy SDHost controller -> external microSD slot. ALT0 mux on
 * GPIO 48..53 via the sdhost_gpio48 group; the SoC DTS leaves this
 * node disabled, unlike the Zero 2 W.
 */
&sdhost {
	pinctrl-names = "default";
	pinctrl-0 = <&sdhost_gpio48>;
	status = "okay";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
	};
};
