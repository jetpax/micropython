/*
 * Pi Zero 2 W devicetree overlay for MicroPython on Zephyr.
 *
 * HAT-layer configuration: things tied to the Pirate Audio HAT rather
 * than the SoC. The board DTS is SoC-only by principle (layered
 * board-config model); HAT pinning, panel definitions, and per-HAT
 * pinctrl groups live here.
 *
 *   - I2S: BCM2835 PCM/I2S on GPIO 18..21 (ALT0). Driven by
 *     drivers/i2s/i2s_bcm2835.c; needs the BCM2835 DMA controller
 *     (also enabled here). machine.I2S is wired up when CONFIG_I2S=y.
 *
 *   - Display: ST7789 240x240 in MIPI-DBI Mode C (4-wire SPI) on SPI0
 *     with GPIO 9 as D/C and GPIO 7 as CS. Write-only -- the HAT
 *     doesn't wire MISO. Backlight on GPIO 13, held high. Tuning
 *     parameters lifted from the in-tree st7789v_waveshare_240x240
 *     shield overlay (closest analog: same panel size, same controller).
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/display/panel.h>

&dma {
	status = "okay";
};

/*
 * I2S: TX-only (PCM_CLK, PCM_FS, PCM_DOUT). PCM_DIN on GPIO 20 is
 * deliberately NOT muxed here, because pre-2020-01-23 Pirate Audio
 * boards wire button Y to GPIO 20 (current boards moved Y to GPIO 24).
 * The stock i2s_gpio18 group includes PCM_DIN; using it would claim
 * GPIO 20 at I2S init and prevent button Y on older HATs.
 *
 * Cost: no I2S RX/capture from this image -- acceptable since the
 * Pirate Audio HAT lineup is all output-only (PCM5100 DAC). Restore
 * the stock i2s_gpio18 group if microphone capture is needed.
 * The bcm283x-pinctrl.dtsi comment anticipates this case directly:
 * "A TX-only board (no capture) can define a 3-pin group omitting
 * PCM_DIN in its overlay."
 */
&i2s {
	status = "okay";
	pinctrl-0 = <&i2s_gpio18_tx_only>;
	pinctrl-names = "default";
};

/*
 * Display wiring on SPI0:
 *   CS  -> GPIO 7  (SPI0_CE1, controller-managed)
 *   D/C -> GPIO 9  (held as a plain GPIO -- the stock spi0_gpio7
 *                   pinctrl group muxes this to MISO/ALT0, which we
 *                   don't want; the MOSI+SCLK-only group below leaves
 *                   GPIO 9 free)
 *   MOSI / SCLK -> GPIO 10 / 11 (ALT0)
 *   Backlight   -> GPIO 13 (regulator-fixed, held high; no PWM in Phase A)
 *
 * The bcm283x-pinctrl.dtsi comment for spi0_gpio7 explicitly anticipates
 * this case: "Write-only displays that need GPIO 9 for a D/C line
 * should define a MOSI+SCLK-only group in the board overlay."
 */
&spi0 {
	pinctrl-0 = <&spi0_mosi_sclk>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
};

&pinctrl {
	i2s_gpio18_tx_only: i2s-gpio18-tx-only {
		group1 {
			pinmux = <PCM_CLK_GPIO18>, <PCM_FS_GPIO19>, <PCM_DOUT_GPIO21>;
		};
	};

	spi0_mosi_sclk: spi0-mosi-sclk {
		group1 {
			pinmux = <SPI0_MOSI_GPIO10>, <SPI0_SCLK_GPIO11>;
		};
	};
};

/*
 * USB CDC ACM as the MP REPL channel. The Zephyr DWC2 controller is
 * disabled in the board SoC DTS (status="disabled" in bcm2710.dtsi);
 * this overlay flips it on, declares a single CDC ACM UART child,
 * and retargets the MP REPL via the chosen `zephyr,uart-mp-repl`.
 * The kernel `zephyr,console` chosen is left alone so PL011 keeps
 * boot logs + panics.
 *
 * &mailbox + &firmware come up too so the DWC2 vendor pre_enable hook
 * can SET_POWER_STATE(USB_HCD, on) at boot, and the new
 * hwinfo_bcm2835 driver can read GET_BOARD_SERIAL for iSerialNumber.
 */
&mailbox {
	status = "okay";
};

&firmware {
	status = "okay";
};

&usb {
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "MP REPL";
	};
};

/ {
	chosen {
		zephyr,display = &st7789v;
		zephyr,uart-mp-repl = &cdc_acm_uart0;
	};

	/*
	 * 16 MiB RAM disk for the development iteration loop. The Pi Zero 2 W
	 * has no SoC-attached flash and our Zephyr tree does not yet have an
	 * SD-card controller driver (sdhc_bcm2835.c covers the Arasan SDHCI
	 * port, which on this board is wired to the CYW43439 wireless chip,
	 * not the microSD slot). Until sdhc_bcm2835_sdhost.c lands, the only
	 * route to a working filesystem is a RAM-backed disk_access disk
	 * formatted with LittleFS. Survives soft-reset (DRAM is untouched);
	 * lost on power-cycle. Sideload via the WBP WebREPL upload path.
	 *
	 * Sizing: 16 MiB. Each sector is 512 B, so 32768 sectors. Big enough
	 * for the device-scripts tree plus all current bundle assets (the
	 * largest single asset is the 1 MiB winamp screensaver frames.bin)
	 * with comfortable headroom for future growth. Cost is paid out of
	 * the BSS region of the image; the 64 MiB MicroPython heap
	 * (CONFIG_MICROPY_HEAP_SIZE in this board's .conf) is unaffected.
	 * See notes/zephyr_storage.html for the full reasoning trail.
	 */
	ramdisk0: ramdisk0 {
		compatible = "zephyr,ram-disk";
		disk-name = "RAM";
		sector-size = <512>;
		sector-count = <32768>;
	};

	mipi_dbi: mipi-dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi0>;
		dc-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		st7789v: st7789v@0 {
			compatible = "sitronix,st7789v";
			reg = <0>;
			mipi-max-frequency = <20000000>;   /* conservative; bump after green */
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
			width = <240>;
			height = <240>;
			x-offset = <0>;
			y-offset = <0>;    /* Pimoroni Pirate Audio: panel rows 0..239 of the 240x320 RAM */
			/* Tuning -- mirrored from st7789v_waveshare_240x240.overlay */
			vcom = <0x19>;
			gctrl = <0x35>;
			vrhs = <0x12>;
			vdvs = <0x20>;
			mdac = <0x00>;
			gamma = <0x01>;
			lcm = <0x2c>;
			porch-param   = [ 0c 0c 00 33 33 ];
			cmd2en-param  = [ 5a 69 02 01 ];
			pwctrl1-param = [ a4 a1 ];
			pvgam-param   = [ d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23 ];
			nvgam-param   = [ d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23 ];
			ram-param     = [ 00 f0 ];
			rgb-param     = [ cd 08 14 ];
		};
	};

	lcd_backlight: lcd_backlight {
		compatible = "regulator-fixed";
		regulator-name = "lcd-backlight";
		enable-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
	};
};
